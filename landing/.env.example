# Public marketing site build. Copy to `.env` and edit; every value has a default.
# Site the marketing pages are served from (used for canonical URLs, sitemap, robots).
PUBLIC_SITE_URL=https://orsquare.com
# Where "Sign in" points. A relative path on the same host, or an absolute app URL.
PUBLIC_APP_URL=/login
# Where "Get started" points. Signup is not built yet, so the default is the
# placeholder page in this project (/signup). Set it to the real signup URL later.
PUBLIC_SIGNUP_URL=/signup
# Public contact address shown on the Contact page and in the mailto: form.
# Left empty on purpose: the owner has not published one yet (see STATUS.md).
PUBLIC_CONTACT_EMAIL=
