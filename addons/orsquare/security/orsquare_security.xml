<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ORSquare roles are thin wrappers over native Odoo groups: Staff Access assigns users to these
         groups and nothing else. No parallel employee-governance system. -->
    <record id="module_category_orsquare" model="ir.module.category">
        <field name="name">ORSquare</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_orsquare_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="module_category_orsquare"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_orsquare_stockkeeper" model="res.groups">
        <field name="name">Stockkeeper</field>
        <field name="category_id" ref="module_category_orsquare"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <!-- Data-masking switches (owner toggles per employee) -->
    <record id="group_orsquare_can_see_money" model="res.groups">
        <field name="name">Can see money (drawer cash, daily revenue)</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_can_see_valuation" model="res.groups">
        <field name="name">Can see valuation (purchase rates, margins, stock value)</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_can_manage_returns" model="res.groups">
        <field name="name">Can manage returns (refunds, credit notes)</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>

    <!-- Tab grants are native groups too (one per tab): Staff Access adds/removes them, the API gate checks them
         server-side, and the owner implies every one. Nothing is stored as free text any more. -->
    <record id="group_orsquare_tab_dashboard" model="res.groups">
        <field name="name">Tab: Dashboard</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_sales" model="res.groups">
        <field name="name">Tab: Sales</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_purchases" model="res.groups">
        <field name="name">Tab: Purchases</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_stock" model="res.groups">
        <field name="name">Tab: Stock</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_products" model="res.groups">
        <field name="name">Tab: Products</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_accounts" model="res.groups">
        <field name="name">Tab: Accounts</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_cashflow" model="res.groups">
        <field name="name">Tab: Cash Flow</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_daybook" model="res.groups">
        <field name="name">Tab: Daybook</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_calendar" model="res.groups">
        <field name="name">Tab: Calendar</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_reports" model="res.groups">
        <field name="name">Tab: Reports / Ledger</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>
    <record id="group_orsquare_tab_settings" model="res.groups">
        <field name="name">Tab: Settings</field>
        <field name="category_id" ref="module_category_orsquare"/>
    </record>

    <record id="group_orsquare_owner" model="res.groups">
        <field name="name">Shop Owner</field>
        <field name="category_id" ref="module_category_orsquare"/>
        <field name="implied_ids" eval="[
            (4, ref('group_orsquare_cashier')),
            (4, ref('group_orsquare_stockkeeper')),
            (4, ref('group_orsquare_can_see_money')),
            (4, ref('group_orsquare_can_see_valuation')),
            (4, ref('group_orsquare_can_manage_returns')),
            (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('account.group_account_manager')),
            (4, ref('hr.group_hr_user')),
            (4, ref('group_orsquare_tab_dashboard')),
            (4, ref('group_orsquare_tab_sales')),
            (4, ref('group_orsquare_tab_purchases')),
            (4, ref('group_orsquare_tab_stock')),
            (4, ref('group_orsquare_tab_products')),
            (4, ref('group_orsquare_tab_accounts')),
            (4, ref('group_orsquare_tab_cashflow')),
            (4, ref('group_orsquare_tab_daybook')),
            (4, ref('group_orsquare_tab_calendar')),
            (4, ref('group_orsquare_tab_reports')),
            (4, ref('group_orsquare_tab_settings')),
        ]"/>
    </record>
</odoo>
