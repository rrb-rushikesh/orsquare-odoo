<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Extension -->
    <record id="view_uom_form_orsquare" model="ir.ui.view">
        <field name="name">uom.uom.form.orsquare</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='active_rounding']" position="inside">
                <separator string="ORSquare Two-Tier Controls"/>
                <field name="is_platform_base" readonly="1"/>
                <field name="is_shop_visible" widget="boolean_toggle"/>
                <field name="orsquare_base_unit_id" options="{'no_create': True}"/>
                <field name="orsquare_ratio" invisible="not orsquare_base_unit_id"/>
            </xpath>
        </field>
    </record>

    <!-- List View Extension -->
    <record id="view_uom_tree_orsquare" model="ir.ui.view">
        <field name="name">uom.uom.list.orsquare</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_type']" position="after">
                <field name="orsquare_base_unit_id" optional="show"/>
                <field name="orsquare_ratio" optional="show"/>
                <field name="is_platform_base" optional="show" widget="badge"/>
                <field name="is_shop_visible" optional="show" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
