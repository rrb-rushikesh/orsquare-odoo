<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Enforce 6-decimal precision on Product Unit of Measure -->
        <record id="product.decimal_product_uom" model="decimal.precision">
            <field name="digits">6</field>
        </record>

        <!-- 2. Configure 6-decimal rounding on Odoo standard base reference units -->
        <record id="uom.product_uom_unit" model="uom.uom">
            <field name="rounding">0.000001</field>
        </record>

        <record id="uom.product_uom_litre" model="uom.uom">
            <field name="rounding">0.000001</field>
        </record>
    </data>
</odoo>
