<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Two operator levels. Admin implies support, so an admin can do everything a support operator can. -->
    <record id="module_category_platform" model="ir.module.category">
        <field name="name">ORSquare Platform</field>
        <field name="sequence">6</field>
    </record>
    <record id="group_platform_support" model="res.groups">
        <field name="name">Platform support (read-only)</field>
        <field name="category_id" ref="module_category_platform"/>
    </record>
    <record id="group_platform_admin" model="res.groups">
        <field name="name">Platform admin</field>
        <field name="category_id" ref="module_category_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_platform_support'))]"/>
    </record>
</odoo>
